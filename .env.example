# ---------------------------------------------------------------------------
# Sanity CMS — project credentials
# ---------------------------------------------------------------------------
# Get your projectId from manage.sanity.io → your project → Settings → API
# Dataset is almost always "production".
# These values are safe to expose in the browser (PUBLIC_ prefix).

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Sanity Studio URL — used to build click-to-edit links in draft mode
# ---------------------------------------------------------------------------
# In production, set this to your deployed Studio URL.
# Leave unset in local dev (defaults to http://localhost:3333).

PUBLIC_SANITY_STUDIO_URL=https://blockandmortar.sanity.studio

# ---------------------------------------------------------------------------
# Draft mode / visual editing secret
# ---------------------------------------------------------------------------
# A random string shared between this site and the Sanity Studio.
# Generate one with: openssl rand -base64 32
# The Studio reads the same value from SANITY_STUDIO_PREVIEW_SECRET.
# In local dev, both sides fall back to 'dev-preview-secret' automatically.
# Server-only — no PUBLIC_ prefix.

SANITY_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Git branch (set automatically by Vercel / GitHub CI — no need to edit)
# ---------------------------------------------------------------------------
# GITHUB_BRANCH=main
