---
import { getClient, sanityClient } from '../lib/sanity';
import { createImageUrlBuilder } from '@sanity/image-url';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamPage from '../components/TeamPage';

const isDraftMode = Astro.cookies.get('sanity-preview')?.value === 'true';
const client = getClient(isDraftMode);

// Image builder only needs projectId/dataset — use the base client for config
const builder = createImageUrlBuilder(sanityClient);

const rawMembers = await client.fetch(
  `*[_type == "teamMember"] | order(order asc){
    name, role, initials, tint, photo, bio, order
  }`
) ?? [];

const members = rawMembers.map((m: any) => ({
  name:     m.name,
  role:     m.role,
  initials: m.initials,
  tint:     m.tint,
  photo:    m.photo
    ? builder.image(m.photo).width(400).height(400).fit('crop').url()
    : null,
  bio:      m.bio,
  order:    m.order,
}));

const teamSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Block and Mortar Team',
  itemListElement: members.map((m: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Person',
      name: m.name,
      jobTitle: m.role,
      image: m.photo ?? undefined,
      description: m.bio,
      worksFor: {
        '@type': 'Organization',
        name: 'Block and Mortar',
        url: 'https://blockandmortar.ai',
      },
    },
  })),
};
---

<BaseLayout
  title="The Team — Block and Mortar"
  description="Meet the Block & Mortar founding team — operators, builders, designers, and engineers who've lived the problems we now build against."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(teamSchema)} />
  <TeamPage members={members} client:only="react" />
</BaseLayout>
