---
import { loadQuery, setServerClient } from '../lib/loader';
import { previewClient, sanityClient } from '../lib/sanity';
import { TEAM_QUERY } from '../lib/queries';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamPage from '../components/TeamPage';

const isDraftMode = Astro.cookies.get('sanity-preview')?.value === 'true';
setServerClient(isDraftMode ? previewClient : sanityClient);

const teamInitial = await loadQuery(TEAM_QUERY);

const teamSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Block and Mortar Team',
  itemListElement: (teamInitial.data ?? []).map((m: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Person',
      name: m.name,
      jobTitle: m.role,
      image: m.photo ?? undefined,
      description: m.bio,
      worksFor: { '@type': 'Organization', name: 'Block and Mortar', url: 'https://blockandmortar.ai' },
    },
  })),
};
---

<BaseLayout
  title="The Team — Block and Mortar"
  description="Meet the Block & Mortar founding team — operators, builders, designers, and engineers who've lived the problems we now build against."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(teamSchema)} />
  <TeamPage teamInitial={teamInitial} isDraftMode={isDraftMode} client:only="react" />
</BaseLayout>
