---
import { loadQuery, setServerClient } from '../lib/loader';
import { previewClient, sanityClient } from '../lib/sanity';
import { LEGAL_QUERY } from '../lib/queries';
import LegalLayout from '../layouts/LegalLayout.astro';
import AccessibilityPage from '../components/AccessibilityPage';

const isDraftMode = Astro.cookies.get('sanity-preview')?.value === 'true';
setServerClient(isDraftMode ? previewClient : sanityClient);

const legalInitial = await loadQuery(LEGAL_QUERY, { pageKey: 'accessibility' });
---

<LegalLayout
  title="Accessibility Statement — Block and Mortar"
  description="Block & Mortar's commitment to WCAG 2.2 AA accessibility, compatible assistive technology, and how to report issues."
>
  <AccessibilityPage legalInitial={legalInitial} isDraftMode={isDraftMode} client:only="react" />
</LegalLayout>
