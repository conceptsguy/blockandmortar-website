---
import { getClient } from '../lib/sanity';
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/App';

const isDraftMode = Astro.cookies.get('sanity-preview')?.value === 'true';
const client = getClient(isDraftMode);

const [homeData, testimonials] = await Promise.all([
  client.fetch(
    `*[_type == "homePage" && _id == "singleton-homePage"][0]{
      heroHeading,
      heroSubheading,
      promptHeading,
      promptHeadingEm,
      promptDescription,
      stepsHeading,
      stepsHeadingEm,
      stepsDescription,
      steps[]{ number, title, body },
      bentoHeading,
      bentoHeadingEm,
      bentoDescription,
      collabHeading,
      collabHeadingEm,
      collabDescription,
      collabFeatures[]{ title, description },
      verticalsHeading,
      verticalsHeadingEm,
      verticalsDescription,
      verticals[]{ key, title, meta },
      ctaHeading,
      ctaHeadingEm,
      ctaDescription
    }`
  ),
  client.fetch(
    `*[_type == "testimonial"] | order(order asc){
      quote,
      personName,
      personTitle
    }`
  ),
]);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Block and Mortar',
  alternateName: 'Block & Mortar',
  url: 'https://blockandmortar.ai',
  logo: 'https://blockandmortar.ai/favicon.svg',
  description:
    'AI-powered cost intelligence platform for real estate development — estimate, plan, and manage construction from a single collaborative workspace.',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'info@blockandmortar.ai',
    contactType: 'customer service',
  },
};
---

<BaseLayout
  title="Block and Mortar — Estimate the build from a prompt"
  description="AI-powered cost intelligence for real estate development. Estimate, plan, and manage construction from a single collaborative platform."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgSchema)} />
  <App
    heroHeading={homeData?.heroHeading}
    heroSubheading={homeData?.heroSubheading}
    promptHeading={homeData?.promptHeading}
    promptHeadingEm={homeData?.promptHeadingEm}
    promptDescription={homeData?.promptDescription}
    stepsHeading={homeData?.stepsHeading}
    stepsHeadingEm={homeData?.stepsHeadingEm}
    stepsDescription={homeData?.stepsDescription}
    steps={homeData?.steps ?? []}
    bentoHeading={homeData?.bentoHeading}
    bentoHeadingEm={homeData?.bentoHeadingEm}
    bentoDescription={homeData?.bentoDescription}
    collabHeading={homeData?.collabHeading}
    collabHeadingEm={homeData?.collabHeadingEm}
    collabDescription={homeData?.collabDescription}
    collabFeatures={homeData?.collabFeatures ?? []}
    verticalsHeading={homeData?.verticalsHeading}
    verticalsHeadingEm={homeData?.verticalsHeadingEm}
    verticalsDescription={homeData?.verticalsDescription}
    verticals={homeData?.verticals ?? []}
    ctaHeading={homeData?.ctaHeading}
    ctaHeadingEm={homeData?.ctaHeadingEm}
    ctaDescription={homeData?.ctaDescription}
    testimonials={testimonials ?? []}
    client:only="react"
  />
</BaseLayout>
