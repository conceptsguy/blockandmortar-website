---
import { loadQuery, setServerClient } from '../lib/loader';
import { previewClient, sanityClient } from '../lib/sanity';
import { LEGAL_QUERY } from '../lib/queries';
import LegalLayout from '../layouts/LegalLayout.astro';
import PrivacyPage from '../components/PrivacyPage';

const isDraftMode = Astro.cookies.get('sanity-preview')?.value === 'true';
setServerClient(isDraftMode ? previewClient : sanityClient);

const legalInitial = await loadQuery(LEGAL_QUERY, { pageKey: 'privacy' });
---

<LegalLayout
  title="Privacy Policy — Block and Mortar"
  description="Block & Mortar's privacy policy — how we collect, use, and protect your information."
>
  <PrivacyPage legalInitial={legalInitial} isDraftMode={isDraftMode} client:only="react" />
</LegalLayout>
