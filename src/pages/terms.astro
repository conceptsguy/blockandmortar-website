---
import { loadQuery, setServerClient } from '../lib/loader';
import { previewClient, sanityClient } from '../lib/sanity';
import { LEGAL_QUERY } from '../lib/queries';
import LegalLayout from '../layouts/LegalLayout.astro';
import TermsPage from '../components/TermsPage';

const isDraftMode = Astro.cookies.get('sanity-preview')?.value === 'true';
setServerClient(isDraftMode ? previewClient : sanityClient);

const legalInitial = await loadQuery(LEGAL_QUERY, { pageKey: 'terms' });
---

<LegalLayout
  title="Terms & Conditions — Block and Mortar"
  description="Block & Mortar's Terms of Service governing access to and use of the platform."
>
  <TermsPage legalInitial={legalInitial} isDraftMode={isDraftMode} client:only="react" />
</LegalLayout>
