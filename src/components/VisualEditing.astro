---
// Activates Sanity's click-to-edit overlays when the site is loaded inside the
// Presentation tool iframe with the draft-mode cookie set.
// Has zero effect on normal page visits.
---
<script>
  if (document.cookie.split(';').some(c => c.trim() === 'sanity-preview=true')) {
    import('@sanity/visual-editing').then(({ enableVisualEditing }) => {
      enableVisualEditing();
    });
  }
</script>
